<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility. CustomTabsClient needs these queries to find a browser for
      warmup. Without them, getPackageName() returns null on Android 11 and later.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="androidx.browser.customtabs.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".DailyTrackerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyTracker">

        <!-- WorkManager is configured in code, so that Hilt can build the worker. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Keep launchMode as singleTop. singleTask finishes the activities above this one
          when the user re-enters the app. FLAG_ACTIVITY_CLEAR_TOP has the same effect.
          Either one closes a Custom Tab with a game in progress.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DailyTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Invisible share target. These attributes keep the Custom Tab of the user in
          place while a result is saved.
        -->
        <activity
            android:name=".share.ReceiveShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_save_result"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DailyTracker.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Shown when shared text does not give its game, or its day. It shares the task
          affinity of the receiver, so the share flow stays out of the app's task.

          Not excluded from recents, unlike the receiver above. This activity needs an answer
          from the user, who may leave part way through. A task kept out of recents cannot be
          returned to.

          The invisible theme again, because the content here is a dialog. The window behind
          it belongs to the browser, and stays on screen.
        -->
        <activity
            android:name=".share.ConfirmShareActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.DailyTracker.Invisible" />
    </application>

</manifest>

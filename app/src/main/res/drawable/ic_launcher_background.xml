<?xml version="1.0" encoding="utf-8"?>
<!-- Full bleed, with no corners. The launcher's mask sets the icon shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#FF1B1B1D" />
                <item android:offset="1" android:color="#FF0E0E0F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

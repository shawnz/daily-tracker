<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer. Android applies a single colour, so the tiles are distinguished by fill
  or outline instead. The launcher draws the themed background, so this layer only contains
  the tiles, at the same 42dp and 448-unit coordinates as ic_launcher_foreground.xml. An
  outlined tile is stroked inside its 128 square, so it occupies the same area as a filled one.
  Kept in step with art/icon-monochrome.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.09375"
        android:scaleY="0.09375"
        android:translateX="33"
        android:translateY="33">

        <!-- Filled: green in the colour icon -->
        <group android:translateX="0" android:translateY="0">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M30,0 L98,0 A30,30 0 0 1 128,30 L128,98 A30,30 0 0 1 98,128 L30,128 A30,30 0 0 1 0,98 L0,30 A30,30 0 0 1 30,0 Z" />
        </group>

        <group android:translateX="0" android:translateY="160">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M30,0 L98,0 A30,30 0 0 1 128,30 L128,98 A30,30 0 0 1 98,128 L30,128 A30,30 0 0 1 0,98 L0,30 A30,30 0 0 1 30,0 Z" />
        </group>

        <group android:translateX="0" android:translateY="320">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M30,0 L98,0 A30,30 0 0 1 128,30 L128,98 A30,30 0 0 1 98,128 L30,128 A30,30 0 0 1 0,98 L0,30 A30,30 0 0 1 30,0 Z" />
        </group>

        <group android:translateX="160" android:translateY="320">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M30,0 L98,0 A30,30 0 0 1 128,30 L128,98 A30,30 0 0 1 98,128 L30,128 A30,30 0 0 1 0,98 L0,30 A30,30 0 0 1 30,0 Z" />
        </group>

        <!-- Outlined: yellow in the colour icon -->
        <group android:translateX="160" android:translateY="160">
            <path
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="16"
                android:fillColor="#00000000"
                android:pathData="M30,8 L98,8 A22,22 0 0 1 120,30 L120,98 A22,22 0 0 1 98,120 L30,120 A22,22 0 0 1 8,98 L8,30 A22,22 0 0 1 30,8 Z" />
        </group>

        <group android:translateX="320" android:translateY="320">
            <path
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="16"
                android:fillColor="#00000000"
                android:pathData="M30,8 L98,8 A22,22 0 0 1 120,30 L120,98 A22,22 0 0 1 98,120 L30,120 A22,22 0 0 1 8,98 L8,30 A22,22 0 0 1 30,8 Z" />
        </group>
    </group>
</vector>
